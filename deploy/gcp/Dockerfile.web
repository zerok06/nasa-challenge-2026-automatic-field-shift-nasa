# Anden — imagen única del sitio: compila el PWA y lo sirve con Caddy,
# que además proxya /api/* al backend (ADR-0010: mismo dominio).
#
# Build (desde la raíz del repo):
#   docker build -f deploy/gcp/Dockerfile.web -t anden/web:latest .

FROM node:22-alpine AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.34.9 --activate

WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./

# Vacío = mismo dominio (Caddy proxya /api/v1). Se puede apuntar a otro backend:
#   --build-arg VITE_API_URL=https://api.example.com
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm build

FROM caddy:2-alpine

# El Caddyfile se monta en tiempo de ejecución (deploy/gcp/Caddyfile) para poder
# cambiar dominio o redirecciones sin reconstruir la imagen.
COPY --from=build /app/dist /srv

EXPOSE 80 443
