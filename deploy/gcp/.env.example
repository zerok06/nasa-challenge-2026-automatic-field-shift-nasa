# Anden — variables del stack GCP. Copiar a .env en la VM; nunca commitear.
APP_ENV=demo
API_PORT=8000

POSTGRES_DB=automatic
POSTGRES_USER=automatic
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://automatic:change_me@db:5432/automatic

JWT_SECRET=change_me_32_chars_minimum
JWT_EXPIRE_MINUTES=10080
# El PWA y la API comparten dominio (ADR-0010). Incluye el dominio canónico.
CORS_ORIGINS=https://anden.duckdns.org

LLM_PROVIDER=gemini
GOOGLE_CLOUD_PROJECT=project-59be27c2-c126-4ea7-b01
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_MAX_TOOL_CALLS=4
GEMINI_TEMPERATURE=0
AGENT_MAX_ANSWER_CHARS=220
LLM_TIMEOUT_SECONDS=20

DATASETS_DIR=/app/datasets
API_IMAGE=us-central1-docker.pkg.dev/project-59be27c2-c126-4ea7-b01/anden/api:latest
# Imagen del PWA (Caddy sirve /srv y proxya /api al backend). El Caddyfile se
# monta desde ./Caddyfile para cambiar dominio/redirecciones sin rebuild.
WEB_IMAGE=us-central1-docker.pkg.dev/project-59be27c2-c126-4ea7-b01/anden/web:latest
API_UPSTREAM=api:8000

# Dominio canónico con HTTPS automático (Caddy/Let's Encrypt).
# - DuckDNS: anden.duckdns.org apuntando a la IP estática de la VM.
# - Sin dominio propio: <ip-con-guiones>.sslip.io
DOMAIN=anden.duckdns.org
