# ============================================================
# Automatic — ejemplo de configuración
# Copiar a .env y completar. NUNCA commitear .env.
# ============================================================

# --- App / API ---
APP_ENV=development
API_PORT=8000

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=automatic
POSTGRES_USER=automatic
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql+psycopg://automatic:change_me_in_local_env@db:5432/automatic

# --- Auth ---
JWT_SECRET=change_me_please_32_chars_minimum_1234
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173,http://localhost:4173

# --- PWA web (frontend/) ---
# URL del backend que usa el NAVEGADOR. Vacío = mismo dominio (Caddy proxya /api).
# Para apuntar el PWA al backend de GCP: https://<dominio-gcp>
VITE_API_URL=http://localhost:8000

# --- LLM / Agent ---
# fake = determinista (tests/offline); gemini = Vertex AI; groq = legado
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_MAX_TOOL_CALLS=4
GEMINI_TEMPERATURE=0
AGENT_MAX_ANSWER_CHARS=220
LLM_TIMEOUT_SECONDS=20

# --- NASA / ingest (solo servicio ingest) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
POWER_CACHE_TTL_HOURS=24

# --- Mobile (público; se copia a application/.env.local) ---
# Expo Go en un teléfono físico NO puede usar localhost: apunta al teléfono.
# Demo GCP (recomendado para teléfono): https://34-55-141-32.sslip.io
# Backend local: http://<ip-lan-de-tu-pc>:8000
# La app reemplaza localhost por el host de Metro si se usa backend local.
EXPO_PUBLIC_API_URL=https://34-55-141-32.sslip.io
EXPO_PUBLIC_DEMO_MODE=true

# --- Observability (opcional) ---
SENTRY_DSN=
LOG_LEVEL=INFO

