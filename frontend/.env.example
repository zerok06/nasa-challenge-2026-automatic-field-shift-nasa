# Producción local por defecto: el PWA llama al backend del compose.
VITE_API_URL=http://localhost:8000

# Para desarrollar contra el backend desplegado en GCP, apunta el navegador allí:
# VITE_API_URL=https://<dominio-gcp>
#
# En el despliegue con Caddy (ADR-0010) el PWA y la API comparten dominio:
# deja VITE_API_URL vacío en el build y las llamadas irán a /api/v1 del mismo host.
